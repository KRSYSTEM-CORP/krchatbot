generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Organización y equipo
// ─────────────────────────────────────────────────────────────────────────────

// ADMIN ve todos los chats de la organización. MEMBER solo ve los chats que
// llevan alguna de las etiquetas que se le asignaron (ver UserLabel) — el
// permiso se modela por etiqueta, no chat por chat, para que dar de alta a un
// agente sea un solo gesto y siga valiendo para los chats que entren mañana.
enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Oculta el teléfono del cliente a los MEMBER en toda la interfaz. Los
  // ADMIN siempre lo ven — alguien tiene que poder auditar.
  maskNumbers Boolean @default(false)
  timezone  String   @default("America/Caracas")

  // Facturación de mantenimiento, gestionada a mano por un super admin de KR
  // System desde /admin — mismo modelo que KYRA CITAS y APP NEW (ver
  // lib/billing.ts): sin pasarela de pago, el dueño reporta su comprobante y
  // un super admin lo aprueba. isExempt la saca de todo cobro; sin
  // nextPaymentDueDate (org recién creada) nunca bloquea.
  isExempt           Boolean   @default(false)
  monthlyFeeUsdCents Int?
  nextPaymentDueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  phones         Phone[]
  contacts       Contact[]
  chats          Chat[]
  messages       Message[]
  labels         Label[]
  tickets        Ticket[]
  tasks          Task[]
  quickReplies   QuickReply[]
  customProps    CustomProperty[]
  agentSettings  AgentSettings?
  knowledgeItems KnowledgeItem[]
  customTools    CustomTool[]
  rules          AutomationRule[]
  broadcasts     Broadcast[]
  chatLists      SavedChatList[]
  trainingRuns   TrainingRun[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  payments       Payment[]
  paymentReports PaymentReport[]
}

model User {
  id           String     @id @default(cuid())
  orgId        String
  email        String
  name         String
  // Opcional porque un usuario que entra por Google nunca tiene contraseña
  // propia — el login la verifica Google, no nosotros. Sigue siendo
  // obligatorio en la práctica para las cuentas creadas por correo/clave:
  // lib/actions/auth.ts la exige al firmar.
  passwordHash String?
  // Presente sólo en cuentas que entraron por "Continuar con Google".
  googleId     String?    @unique
  avatarUrl    String?
  role         Role       @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  // Administrador de la plataforma (KR System), no de una org — puede
  // aprobar/rechazar reportes de pago y gestionar cualquier org desde
  // /admin. No se puede activar desde la app; sólo directo en la base de
  // datos (ver seed).
  isSuperAdmin Boolean    @default(false)
  // El agente marca "disponible" para recibir asignaciones automáticas.
  isAvailable  Boolean    @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org          Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  labelAccess  UserLabel[]
  assignedChats   Chat[]     @relation("ChatAssignee")
  assignedTickets Ticket[]   @relation("TicketAssignee")
  createdTickets  Ticket[]   @relation("TicketCreator")
  assignedTasks   Task[]     @relation("TaskAssignee")
  createdTasks    Task[]     @relation("TaskCreator")
  notes           PrivateNote[]
  auditLogs       AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@unique([orgId, email])
  @@index([orgId])
}

// Tokens de un solo uso y corta duración para "olvidé mi contraseña". Sólo
// se guarda el hash sha256 del token — igual que una contraseña, el valor
// crudo sólo existe en el enlace que se manda por correo y en el navegador
// de quien lo pide, así que una fuga de la base sola no sirve para resetear
// nada.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Facturación de mantenimiento (manual, sin pasarela — ver lib/billing.ts)
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  TRANSFER
  PAGO_MOVIL
  ZELLE
  BINANCE
  OTHER
}

enum PaymentReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// Un pago de mantenimiento ya confirmado — el registro que empuja
// nextPaymentDueDate. Siempre lo crea un super admin (a mano, o al aprobar
// un PaymentReport).
model Payment {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  amountUsdCents Int
  // Tasa Bs/USD de la plataforma vigente al momento del pago — sólo para
  // mostrar el equivalente en bolívares, nunca para calcular el monto en sí
  // (todo se cobra en USD).
  exchangeRate   Decimal  @db.Decimal(12, 4)
  periodEnd      DateTime
  note           String?
  verifiedById   String
  createdAt      DateTime @default(now())

  @@index([orgId, createdAt])
}

// El reclamo de un ADMIN de haber pagado el mantenimiento por fuera de la
// app (transferencia, Pago Móvil, Zelle, Binance). Queda PENDING hasta que
// un super admin lo revisa desde /admin — aprobarlo crea el Payment y
// adelanta Org.nextPaymentDueDate; rechazarlo no cambia nada del estado de
// cobro.
model PaymentReport {
  id                String              @id @default(cuid())
  orgId             String
  org               Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reportedById      String
  // Comprobante de pago (imagen en base64), mismo patrón de almacenamiento
  // que otros campos de imagen de este proyecto.
  proofImageDataUrl String?             @db.Text
  note              String?
  status            PaymentReportStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime            @default(now())
  lines             PaymentReportLine[]

  @@index([orgId, status])
  @@index([status, createdAt])
}

// Una línea de método de pago dentro de un reporte (ej. parte transferencia,
// parte Pago Móvil).
model PaymentReportLine {
  id              String        @id @default(cuid())
  paymentReportId String
  paymentReport   PaymentReport @relation(fields: [paymentReportId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod
  amountUsdCents  Int
  reference       String?

  @@index([paymentReportId])
}

// Fila única de configuración global de la plataforma (no por org),
// gestionada por el super admin desde /admin.
model PlatformSettings {
  id                        String   @id
  // Extra free-text notes shown under the Binance details below — the QR/ID
  // pair are the actual payment instructions now, this is just supplementary.
  paymentInstructions       String?  @db.Text
  // Binance Pay QR code, shown on /facturacion so an org can scan it to pay
  // the subscription — same base64 data-URL pattern used elsewhere for
  // uploaded images, saved via PlatformSettingsForm (resizeImageToDataUrl).
  binanceQrDataUrl          String?  @db.Text
  // Binance Pay ID / UID, shown alongside the QR as a manual fallback for
  // whoever can't scan it.
  binanceId                 String?
  billingExchangeRate       Decimal? @db.Decimal(12, 4)
  // Se aplica automáticamente al monthlyFeeUsdCents de toda org nueva (ver
  // createOrgWithOwner en lib/org-provisioning.ts).
  defaultMonthlyFeeUsdCents Int?
  updatedAt                 DateTime @updatedAt
}

// Etiqueta: organiza chats/contactos/tickets Y define el acceso de los MEMBER.
model Label {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#4f3ddb")
  createdAt DateTime @default(now())

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chats    ChatLabel[]
  tickets  TicketLabel[]
  access   UserLabel[]

  @@unique([orgId, name])
  @@index([orgId])
}

model UserLabel {
  userId  String
  labelId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([userId, labelId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Números de WhatsApp conectados (instancias de Evolution API)
// ─────────────────────────────────────────────────────────────────────────────

enum PhoneStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTING
  CONNECTED
}

// Un Phone es una sesión de WhatsApp Web viva en Evolution API. `instanceName`
// es la clave con la que Evolution la identifica; `jid` sólo se conoce una vez
// que el QR fue escaneado y la sesión abrió.
model Phone {
  id           String      @id @default(cuid())
  orgId        String
  label        String
  instanceName String      @unique
  jid          String?     @unique
  number       String?
  status       PhoneStatus @default(DISCONNECTED)
  qrCode       String?
  lastQrAt     DateTime?
  connectedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  org        Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chats      Chat[]
  messages   Message[]
  broadcasts Broadcast[]

  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contactos, chats y mensajes
// ─────────────────────────────────────────────────────────────────────────────

enum ChatType {
  USER
  GROUP
}

model Contact {
  id        String   @id @default(cuid())
  orgId     String
  // JID nativo de WhatsApp: "584121234567@s.whatsapp.net".
  jid       String
  name      String?
  pushName  String?
  number    String?
  imageUrl  String?
  // Los contactos internos (el propio equipo) quedan fuera de la activación
  // de la IA: no queremos que el agente responda a sus propios compañeros.
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  ChatMember[]

  @@unique([orgId, jid])
  @@index([orgId])
}

// El agente de IA por chat: INACTIVE monitorea, ACTIVE responderá al próximo
// mensaje externo, THINKING está redactando, SNOOZED se calló porque un humano
// tomó el control (ver AgentSettings.snoozeMinutes).
enum AgentState {
  INACTIVE
  ACTIVE
  THINKING
  SNOOZED
}

model Chat {
  id         String   @id @default(cuid())
  orgId      String
  phoneId    String
  // JID del chat: "5841...@s.whatsapp.net" (1:1) o "1203...@g.us" (grupo).
  chatId     String
  type       ChatType
  name       String
  imageUrl   String?
  inviteLink String?
  isMuted    Boolean  @default(false)
  isArchived Boolean  @default(false)
  unreadCount Int     @default(0)
  lastMessageAt DateTime?
  closedAt   DateTime?
  assigneeId String?

  // Interruptores de IA por chat, independientes del maestro de la org.
  aiEnabled   Boolean    @default(true)
  aiFlagging  Boolean    @default(true)
  agentState  AgentState @default(INACTIVE)
  snoozedUntil DateTime?

  customProps Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone    Phone         @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  assignee User?         @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  members  ChatMember[]
  messages Message[]
  notes    PrivateNote[]
  labels   ChatLabel[]
  tickets  Ticket[]
  tasks    Task[]

  @@unique([orgId, chatId])
  @@index([orgId, lastMessageAt])
  @@index([phoneId])
}

model ChatMember {
  chatId    String
  contactId String
  isAdmin   Boolean @default(false)

  chat    Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([chatId, contactId])
}

model ChatLabel {
  chatId  String
  labelId String

  chat  Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([chatId, labelId])
}

enum MessageAck {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageKind {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  SYSTEM
}

// Quién produjo el mensaje saliente. AI es lo que permite mostrar el
// nickname del agente al cliente y medir cuánto resolvió la IA sin humano.
enum MessageAuthorKind {
  CONTACT
  AGENT
  AI
  SYSTEM
}

model Message {
  id        String      @id @default(cuid())
  orgId     String
  chatId    String
  phoneId   String
  // ID que asigna WhatsApp. Nulo mientras el mensaje sólo existe en nuestra
  // cola de salida (ver QueueJob) y todavía no salió.
  waId      String?
  fromJid   String
  fromMe    Boolean
  authorKind MessageAuthorKind @default(CONTACT)
  kind      MessageKind @default(TEXT)
  body      String      @default("")
  mediaUrl  String?
  mimeType  String?
  // Nombre legible del archivo — la burbuja de documento lo muestra en vez
  // de la clave de almacenamiento, que es un identificador opaco.
  fileName  String?
  // Sólo cuando kind = LOCATION.
  latitude  Float?
  longitude Float?
  // Sólo cuando kind = AUDIO (nota de voz): permite pintar la duración en la
  // burbuja sin tener que descargar el archivo para medirlo.
  durationSeconds Int?
  quotedId  String?
  ack       MessageAck  @default(PENDING)
  // Marcado como importante, por la IA o a mano. Alimenta las métricas de
  // "preguntas sin responder" y el tiempo de primera respuesta.
  isFlagged Boolean     @default(false)
  flagReason String?
  reactions Json        @default("[]")
  timestamp DateTime
  createdAt DateTime    @default(now())

  org   Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chat  Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  phone Phone @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  tasks   Task[]

  @@unique([orgId, waId])
  @@index([chatId, timestamp])
  @@index([orgId, timestamp])
  @@index([orgId, isFlagged])
}

// Mensaje interno dentro del chat: el cliente nunca lo ve. Es la mitad del
// mecanismo de escalamiento (la otra mitad es el ticket).
model PrivateNote {
  id        String   @id @default(cuid())
  chatId    String
  authorId  String?
  // Emails o ids de usuarios mencionados con @ — a quienes hay que notificar.
  mentions  String[] @default([])
  byAi      Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  chat   Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tickets y tareas
// ─────────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  chatId      String?
  messageId   String?
  number      Int
  title       String
  description String       @default("")
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  assigneeId  String?
  createdById String?
  byAi        Boolean      @default(false)
  customProps Json         @default("{}")
  // Fecha límite del SLA. Las reglas de automatización pueden disparar sobre
  // el incumplimiento (ver AutomationTrigger.SLA_BREACHED).
  dueAt       DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chat      Chat?         @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message   Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  assignee  User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  labels    TicketLabel[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([chatId])
}

model TicketLabel {
  ticketId String
  labelId  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label  Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id          String     @id @default(cuid())
  orgId       String
  chatId      String?
  messageId   String?
  title       String
  notes       String     @default("")
  status      TaskStatus @default(OPEN)
  priority    Priority   @default(MEDIUM)
  assigneeId  String?
  createdById String?
  dueAt       DateTime?
  remindAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chat      Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Propiedades personalizadas y respuestas rápidas
// ─────────────────────────────────────────────────────────────────────────────

enum PropertyScope {
  CHAT
  TICKET
}

enum PropertyKind {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  CHECKBOX
}

model CustomProperty {
  id        String        @id @default(cuid())
  orgId     String
  scope     PropertyScope
  kind      PropertyKind
  name      String
  section   String        @default("General")
  required  Boolean       @default(false)
  options   String[]      @default([])
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, scope, name])
  @@index([orgId])
}

model QuickReply {
  id        String   @id @default(cuid())
  orgId     String
  shortcut  String
  body      String
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, shortcut])
}

// ─────────────────────────────────────────────────────────────────────────────
// Capa de IA
// ─────────────────────────────────────────────────────────────────────────────

// AUTO: la IA está encendida en todos los chats y se apaga uno a uno.
// MANUAL: apagada por defecto, se enciende sólo donde se quiera.
enum ActivationMode {
  AUTO
  MANUAL
}

model AgentSettings {
  id     String @id @default(cuid())
  orgId  String @unique

  enabled     Boolean        @default(false)
  nickname    String         @default("Asistente")
  activation  ActivationMode @default(MANUAL)

  // Modo pasivo: la IA analiza, crea tickets y notas privadas, pero no le
  // escribe al cliente. Es la forma segura de estrenar el agente.
  canSendMessages    Boolean @default(false)
  canCreateTickets   Boolean @default(true)
  canCreatePrivateNotes Boolean @default(true)
  canTranslate       Boolean @default(true)

  // Segundos que espera antes de responder, para no contestar en el mismo
  // instante en que llega el mensaje (y para dejar que un humano se adelante).
  responseDelaySeconds Int @default(20)
  // Minutos que la IA queda en SNOOZED tras la intervención de un humano.
  snoozeMinutes        Int @default(60)
  // Whitelist de números (jid del Phone). Vacío = todos.
  allowedPhoneIds      String[] @default([])

  // Los cuatro campos de Personalización. Son prompts, no formularios: se
  // inyectan tal cual en el system prompt del agente.
  rolePrompt       String @default("")
  restrictions     String @default("")
  personality      String @default("Cálido, claro y directo. Respuestas breves.")
  activationPrompt String @default("")

  // Reglas en lenguaje natural para las herramientas nativas.
  ticketRules      String @default("")
  privateNoteRules String @default("")
  flaggingPrompt   String @default("")

  // Auto-entrenamiento semanal a partir de los chats resueltos.
  selfTrainingEnabled  Boolean @default(false)
  selfTrainingRequiresReview Boolean @default(true)

  // Horario de funcionamiento: fuera de estos días/horas (zona de Org.timezone)
  // la IA no responde y, si hay mensaje configurado, se manda uno solo avisando
  // que está fuera de horario en vez de dejar al cliente sin nada.
  businessHoursEnabled Boolean @default(false)
  businessHoursStart   String  @default("09:00")
  businessHoursEnd     String  @default("18:00")
  // 0 = domingo … 6 = sábado (igual que Date#getDay).
  businessHoursDays    Int[]   @default([1, 2, 3, 4, 5])
  businessHoursAwayMessage String @default("Gracias por tu mensaje. En este momento estamos fuera de nuestro horario de atención — te responderemos en cuanto abramos.")

  // Clave de IA propia de la organización, en vez de la clave global del
  // despliegue (ver lib/ai/client.ts). Null = usa la global. Se guarda
  // cifrada (ver lib/crypto.ts); es una organización trayendo su propia
  // cuenta de pago, así que no puede quedar en texto plano en la base.
  aiProvider       String?
  aiApiKeyEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum KnowledgeSource {
  FAQ
  SELF_LEARNED
  DOCUMENT
}

enum KnowledgeStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
}

// Una sola tabla para FAQs, fragmentos de documentos y lo auto-aprendido —
// como en el producto que analizamos, la base de conocimiento es una lista
// con pestañas, no tres almacenes distintos.
model KnowledgeItem {
  id        String          @id @default(cuid())
  orgId     String
  source    KnowledgeSource @default(FAQ)
  status    KnowledgeStatus @default(ACTIVE)
  // Variantes de la misma pregunta, una por línea. Cuantas más, mejor
  // encuentra la búsqueda la entrada correcta.
  question  String
  answer    String
  // Guía de comportamiento específica de esta entrada.
  instructions String @default("")
  attachmentUrl String?
  documentName  String?
  // Nº de fragmento cuando la entrada viene de un PDF troceado.
  chunkIndex    Int?
  // Chat del que se aprendió, cuando source = SELF_LEARNED.
  learnedFromChatId String?
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, source])
}

enum HttpMethod {
  GET
  POST
}

enum ToolAuthType {
  NONE
  BEARER
  API_KEY
  BASIC
}

// Herramienta a medida: la IA la llama por function calling cuando la
// descripción encaja con lo que pide el cliente.
model CustomTool {
  id          String       @id @default(cuid())
  orgId       String
  // snake_case, es el nombre que ve el modelo.
  name        String
  description String
  method      HttpMethod   @default(GET)
  endpoint    String
  authType    ToolAuthType @default(NONE)
  authValue   String?
  authHeader  String?
  headers     Json         @default("{}")
  // [{ name, type, description, required }]
  parameters  Json         @default("[]")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

enum TrainingStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model TrainingRun {
  id         String         @id @default(cuid())
  orgId      String
  weekStart  DateTime
  status     TrainingStatus @default(QUEUED)
  learned    Int            @default(0)
  isManual   Boolean        @default(false)
  error      String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, weekStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Automatización determinista
// ─────────────────────────────────────────────────────────────────────────────

enum AutomationTrigger {
  MESSAGE_RECEIVED
  CHAT_CREATED
  LABEL_ADDED
  LABEL_REMOVED
  MESSAGE_FLAGGED
  REACTION_ADDED
  TICKET_CREATED
  SLA_BREACHED
}

model AutomationRule {
  id        String            @id @default(cuid())
  orgId     String
  name      String
  trigger   AutomationTrigger
  isActive  Boolean           @default(true)
  // Números sobre los que aplica. Vacío = todos.
  phoneIds  String[]          @default([])
  // Árbol AND/OR anidado hasta 2 niveles — ver lib/automation/engine.ts.
  conditions Json             @default("{\"op\":\"AND\",\"items\":[]}")
  // [{ type, delaySeconds, ...params }]
  actions    Json             @default("[]")
  runCount   Int              @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, trigger, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Envíos masivos y cola de salida
// ─────────────────────────────────────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  DONE
  FAILED
}

enum RepeatMode {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Broadcast {
  id        String          @id @default(cuid())
  orgId     String
  phoneId   String
  name      String
  body      String
  mediaUrl  String?
  status    BroadcastStatus @default(DRAFT)
  repeat    RepeatMode      @default(NONE)
  scheduledAt DateTime?
  // Segundos entre envío y envío. Mandar 300 mensajes de golpe desde una
  // sesión de WhatsApp Web es la forma más rápida de que la baneen.
  throttleSeconds Int       @default(8)
  sentCount   Int           @default(0)
  failedCount Int           @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  org        Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone      Phone                @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([orgId, status])
}

model BroadcastRecipient {
  id          String     @id @default(cuid())
  broadcastId String
  chatJid     String
  name        String     @default("")
  // Valores por destinatario para las variables {{ }} del cuerpo.
  variables   Json       @default("{}")
  ack         MessageAck @default(PENDING)
  error       String?
  sentAt      DateTime?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, ack])
}

model SavedChatList {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  // [{ jid, name }]
  entries   Json     @default("[]")
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

enum JobStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

// Cola de salida. Separar "encolado" de "enviado" es lo que permite reintentar,
// respetar el throttle y no perder mensajes si Evolution se cae.
model QueueJob {
  id          String    @id @default(cuid())
  orgId       String
  phoneId     String
  chatJid     String
  body        String
  // Mismo repertorio que Message.kind: decide a qué endpoint de Evolution
  // llamar al drenar (sendText/sendMedia/sendLocation — ver lib/queue.ts).
  kind        MessageKind @default(TEXT)
  mediaUrl    String?
  mimeType    String?
  fileName    String?
  latitude    Float?
  longitude   Float?
  durationSeconds Int?
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  lastError   String?
  runAt       DateTime  @default(now())
  broadcastId String?
  recipientId String?
  // Para que el mensaje aparezca atribuido a la IA en el hilo.
  authorKind  MessageAuthorKind @default(AGENT)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([status, runAt])
  @@index([orgId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Integraciones y auditoría
// ─────────────────────────────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(cuid())
  orgId     String
  url       String
  secret    String
  events    String[] @default([])
  isActive  Boolean  @default(true)
  lastError String?
  createdAt DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  target    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}
